#version 460
#extension GL_EXT_ray_tracing : enable
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba32f) uniform image2D outputImage;
layout(set = 0, binding = 5, std140) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    mat4 prevView;
    mat4 prevProj;
} cam;

layout(push_constant) uniform PushConstants {
    int frame;
};

layout(location = 0) rayPayloadEXT HitPayload payload;

void createCoordinateSystem(in vec3 N, out vec3 T, out vec3 B)
{
    if(abs(N.x) > abs(N.y))
        T = vec3(N.z, 0, -N.x) / sqrt(N.x * N.x + N.z * N.z);
    else
        T = vec3(0, -N.z, N.y) / sqrt(N.y * N.y + N.z * N.z);
    B = cross(N, T);
}

vec3 sampleHemisphere(float rand1, float rand2)
{
    vec3 dir;
    dir.x = cos(2 * M_PI * rand2) * sqrt(1 - rand1 * rand1);
    dir.y = sin(2 * M_PI * rand2) * sqrt(1 - rand1 * rand1);
    dir.z = rand1;
    return dir;
}

vec3 sampleDirection(float rand1, float rand2, vec3 normal)
{
    vec3 tangent;
    vec3 bitangent;
    createCoordinateSystem(normal, tangent, bitangent);
    vec3 dir = sampleHemisphere(rand1, rand2);
    return dir.x * tangent + dir.y * bitangent + dir.z * normal;
}

float schlick(float cosTheta, float eta)
{
    float r0 = (1.0 - eta) / (1.0 + eta);
    r0 = r0 * r0;
    return r0 + (1.0 - r0) * pow(1.0 - cosTheta, 5.0);
}

// Integer hash
uint hash(uint x) {
    x = ((x >> 16u) ^ x) * 0x45d9f3bu;
    x = ((x >> 16u) ^ x) * 0x45d9f3bu;
    x =  (x >> 16u) ^ x;
    return x;
}

float random(uint seed) {
    return float(hash(seed)) / float(0xffffffffu);
}


void main()
{
    int maxSamples = 32;
    vec3 color = vec3(0.0);
    for(uint sampleNum = 0; sampleNum < maxSamples; sampleNum++){
        // Calc seed
        //uvec2 s = pcg2d(ivec2(gl_LaunchIDEXT.xy) * (sampleNum + maxSamples * frame + 1));
        //uint seed = s.x + s.y;
        uint base = (frame * maxSamples + sampleNum); 
        uint seed = base ^ (gl_LaunchIDEXT.x * 1973u + gl_LaunchIDEXT.y * 9277u);
        uint seed2 = seed+1;
        uint seed3 = seed+2;
        uint seed4 = seed+3;

		float r1 = random(seed);
		float r2 = random(seed2);
		vec2 screenPos = vec2(gl_LaunchIDEXT.xy) + vec2(r1, r2);
		vec2 uv = screenPos / vec2(gl_LaunchSizeEXT.xy);     // [0, 1]
		vec2 ndc = uv * 2.0 - 1.0;                            // [-1, 1]

		// Project into clip space (z = -1, w = 1 for a ray on near plane)
		vec4 clip = vec4(ndc, -1.0, 1.0);

		// Inverse project to world space
		mat4 invViewProj = inverse(cam.proj * cam.view);
		vec4 world = invViewProj * clip;
		world /= world.w;

		// Camera origin = eye position in world space
		vec3 origin = inverse(cam.view)[3].xyz;

		// Final ray direction
		vec3 direction = normalize(world.xyz - origin);

        vec3 weight = vec3(1.0);
        payload.done = false;

        for(uint depth = 0; depth < 16; depth++){
            traceRayEXT(
                topLevelAS,
                gl_RayFlagsOpaqueEXT,
                0xff, // cullMask
                0,    // sbtRecordOffset
                0,    // sbtRecordStride
                0,    // missIndex
                origin.xyz,
                0.001,
                direction.xyz,
                10000.0,
                0     // payloadLocation
            );
            color += weight * payload.emission;
            origin.xyz = payload.position;

            if (payload.materialType == 0) {
				// Diffuse
				direction = sampleDirection(rand(seed3), rand(seed4), payload.normal);
				float pdf = 1.0 / (2.0 * M_PI);
				weight *= payload.brdf * max(dot(direction, payload.normal), 0.0) / pdf;

			} else if (payload.materialType == 1) {
				// Mirror (perfect reflection)
				direction = reflect(direction, payload.normal);
				weight *= payload.specular;

			} else if (payload.materialType == 2) {
				// Dielectric (glass)
				vec3 N = payload.normal;
				float eta = payload.ior;

				// Flip normal if exiting
				float cosTheta = dot(-direction, N);
				bool entering = cosTheta > 0.0;
				if (!entering) {
					N = -N;
					eta = 1.0 / eta;
					cosTheta = dot(-direction, N);
				}

				float fresnel = schlick(cosTheta, eta);
				if (rand(seed4) < fresnel) {
					// Reflect
					direction = reflect(direction, N);
				} else {
					// Refract
					vec3 refracted = refract(direction, N, 1.0 / eta);
					if (length(refracted) > 0.0) {
						direction = refracted;
					} else {
						// Total internal reflection fallback
						direction = reflect(direction, N);
					}
				}

				weight *= vec3(1.0); // Glass is uncolored in this model
			}



	            if(payload.done){
                break;
            }
        }
    }
    color /= maxSamples;
    
    vec4 oldColor = imageLoad(outputImage, ivec2(gl_LaunchIDEXT.xy));
    vec4 newColor = vec4(color, 1.0);
    //newColor = (newColor + (oldColor * frame)) / (frame + 1);
    imageStore(outputImage, ivec2(gl_LaunchIDEXT.xy), newColor);
}
