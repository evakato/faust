#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba32f) uniform readonly image2D currNormals;
layout(binding = 1, r32ui) uniform readonly uimage2D currMeshIds;
layout(set = 0, binding = 2) uniform sampler2D currDepths;

layout(binding = 3, rgba32f) uniform readonly image2D prevNormals;
layout(binding = 4, r32ui) uniform readonly uimage2D prevMeshIds;
layout(set = 0, binding = 5) uniform sampler2D prevDepths;

layout(binding = 6, rg32f) uniform readonly image2D motionVectors;
layout(binding = 7, rgba8)   uniform readonly image2D luminance;

layout(binding = 8, rgba8)   uniform readonly image2D colorHistory;
layout(binding = 9, rgba8)   uniform writeonly image2D updatedColorHistory;

layout(binding = 10, rgba16f)   uniform readonly image2D moment2History;
layout(binding = 11, rgba16f)   uniform writeonly image2D updatedMoment2;

layout(binding = 12, rgba16f)   uniform writeonly image2D varianceImage;

layout(push_constant) uniform PushConstants {
    uint frameIndex;
};


bool isConsistent(vec3 currNormal, float currDepth, uint currId,
                  vec3 prevNormal, float prevDepth, uint prevId) {
    float normalDot = dot(currNormal, prevNormal);
    float depthDiff = abs(currDepth - prevDepth);
    return (normalDot > 0.95) && (depthDiff < 0.01) && (currId == prevId);
}

vec4 safeFetch(ivec2 c, ivec2 imageSize, vec3 currNormal, float currDepth, uint currId, out bool valid, out vec4 prevMoment2) {
    prevMoment2 = vec4(0.0);

    if (all(greaterThanEqual(c, ivec2(0))) && all(lessThan(c, imageSize))) {
		vec3 prevNormal = imageLoad(prevNormals, c).xyz;
		float prevDepth = texelFetch(prevDepths, c, 0).r;
		uint prevId = imageLoad(prevMeshIds, c).r;

        if (isConsistent(currNormal, currDepth, currId, prevNormal, prevDepth, prevId)) {
			valid = true;
            prevMoment2 = imageLoad(moment2History, c);
			return imageLoad(colorHistory, c);
        }
    } 
	valid = false;
	return vec4(0.0);
}

vec4 bilinearTap(vec2 coord, ivec2 imageSize, vec3 currNormal, float currDepth, uint currId, out vec4 weightedM) {
    vec2 base = floor(coord);
    vec2 frac = coord - base;
    ivec2 baseCoord = ivec2(base);

    bool v00, v10, v01, v11;
    vec4 m00, m10, m01, m11;
    vec4 c00 = safeFetch(baseCoord + ivec2(0, 0), imageSize, currNormal, currDepth, currId, v00, m00);
    vec4 c10 = safeFetch(baseCoord + ivec2(1, 0), imageSize, currNormal, currDepth, currId, v10, m10);
    vec4 c01 = safeFetch(baseCoord + ivec2(0, 1), imageSize, currNormal, currDepth, currId, v01, m01);
    vec4 c11 = safeFetch(baseCoord + ivec2(1, 1), imageSize, currNormal, currDepth, currId, v11, m11);

    float w00 = (1.0 - frac.x) * (1.0 - frac.y);
    float w10 = (frac.x)       * (1.0 - frac.y);
    float w01 = (1.0 - frac.x) * (frac.y);
    float w11 = (frac.x)       * (frac.y);

    vec4 accumColor = vec4(0.0);
    vec4 accumM     = vec4(0.0);
    float totalWeight = 0.0;

    if (v00) { accumColor += c00 * w00; accumM += m00 * w00; totalWeight += w00; }
    if (v10) { accumColor += c10 * w10; accumM += m10 * w10; totalWeight += w10; }
    if (v01) { accumColor += c01 * w01; accumM += m01 * w01; totalWeight += w01; }
    if (v11) { accumColor += c11 * w11; accumM += m11 * w11; totalWeight += w11; }

    if (totalWeight > 0.0) {
        weightedM = accumM / totalWeight;
        return accumColor / totalWeight;
    } else {
        weightedM = vec4(0.0);
        return vec4(0.0);
    }
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(luminance);
    vec4 currColor = imageLoad(luminance, coord);

    if (frameIndex == 0) 
    {
		imageStore(updatedColorHistory, coord, currColor);
		imageStore(updatedMoment2, coord, currColor * currColor);
        vec4 variance = max(currColor - currColor * currColor, vec4(0.0));
		imageStore(varianceImage, coord, variance);
    } else {

		vec2 motionVec = imageLoad(motionVectors, coord).rg;
		vec2 prevCoordF = vec2(coord) - motionVec * vec2(imageSize); // in pixel space

		vec3 currNormal = imageLoad(currNormals, coord).xyz;
		float currDepth = texelFetch(currDepths, coord, 0).r;
		uint currMeshId = imageLoad(currMeshIds, coord).r;

		vec4 prevMoment2;
		vec4 prevColor = bilinearTap(prevCoordF, imageSize, currNormal, currDepth, currMeshId, prevMoment2);

		float alpha = 0.8;
		vec4 integratedColor = mix(currColor, prevColor, alpha);
		if (length(prevColor) == 0.0) integratedColor = currColor;

		vec4 integratedMoment2 = mix(currColor * currColor, prevMoment2, alpha);
		if (length(prevMoment2) == 0.0) integratedMoment2 = currColor * currColor;

        vec4 variance = max(integratedMoment2 - integratedColor * integratedColor, vec4(0.0));

		imageStore(updatedColorHistory, coord, integratedColor);
		imageStore(updatedMoment2, coord, integratedMoment2);
		imageStore(varianceImage, coord, variance);
    }
}
