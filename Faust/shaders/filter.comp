#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba32f) uniform readonly image2D currNormals;
layout(binding = 1, r32ui) uniform readonly uimage2D currMeshIds;
layout(set = 0, binding = 2) uniform sampler2D currDepths;

layout(binding = 3, rgba32f) uniform readonly image2D prevNormals;
layout(binding = 4, r32ui) uniform readonly uimage2D prevMeshIds;
layout(set = 0, binding = 5) uniform sampler2D prevDepths;

layout(binding = 6, rg32f) uniform readonly image2D motionVectors;
layout(binding = 7, rgba8)   uniform readonly image2D luminance;
layout(binding = 8, rgba8)   uniform readonly image2D colorHistory;
layout(binding = 9, rgba8)   uniform writeonly image2D outImage;

bool isConsistent(vec3 currNormal, float currDepth, uint currId,
                  vec3 prevNormal, float prevDepth, uint prevId) {
    float normalDot = dot(currNormal, prevNormal);
    float depthDiff = abs(currDepth - prevDepth);
    return (normalDot > 0.95) && (depthDiff < 0.01) && (currId == prevId);
}

vec4 bilinearSampleWithConsistency(
    vec2 prevCoord,
    vec3 currNormal,
    float currDepth,
    uint currMeshId,
    ivec2 imageSize
) {
    ivec2 base = ivec2(floor(prevCoord));
    vec2 f = fract(prevCoord); // interpolation weights

    vec4 accum = vec4(0.0);
    float totalWeight = 0.0;

    for (int dy = 0; dy <= 1; ++dy) {
        for (int dx = 0; dx <= 1; ++dx) {
            ivec2 offset = base + ivec2(dx, dy);
            if (any(lessThan(offset, ivec2(0))) || any(greaterThanEqual(offset, imageSize)))
                continue;

            vec3 prevNormal = imageLoad(prevNormals, offset).xyz;
            float prevDepth = texelFetch(prevDepths, offset, 0).r;
            uint prevId = imageLoad(prevMeshIds, offset).r;

            if (true || isConsistent(currNormal, currDepth, currMeshId, prevNormal, prevDepth, prevId)) {
                float w = ((dx == 0) ? (1.0 - f.x) : f.x) *
                          ((dy == 0) ? (1.0 - f.y) : f.y);

                vec4 color = imageLoad(colorHistory, offset); // historical color
                accum += color * w;
                totalWeight += w;
            }
        }
    }

    if (totalWeight > 0.0)
        return accum / totalWeight;
    else
        return vec4(0); // Or fallback: current frame value
}


void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(luminance);
    vec2 motionVec = imageLoad(motionVectors, coord).rg;
    vec2 prevCoord = vec2(coord) - motionVec * vec2(imageSize);

    vec3 currNormal = imageLoad(currNormals, coord).xyz;
    float currDepth = texelFetch(currDepths, coord, 0).r;
    uint currMeshId = imageLoad(currMeshIds, coord).r;

    // sanity check is it workign?
    //uint currMeshId2 = imageLoad(prevMeshIds, coord).r;
    //float currDepth2 = texelFetch(prevDepths, coord, 0).r;
    //vec3 currNormal2 = imageLoad(prevNormals, coord).xyz;

    vec4 filtered = bilinearSampleWithConsistency(prevCoord, currNormal, currDepth, currMeshId, imageSize);
    vec4 currColor = imageLoad(luminance, coord);
    float alpha = 0.2;
    vec4 integratedColor = (length(filtered) > 0.0) ? mix(currColor, filtered, alpha) : currColor;

    imageStore(outImage, coord, integratedColor);
}
